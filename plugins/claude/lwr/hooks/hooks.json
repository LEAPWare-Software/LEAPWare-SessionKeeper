{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/lwr_hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/bin/lwr_hook.py\"",
            "timeout": 10,
            "statusMessage": "lwr: checking dispatch against token policy"
          }
        ]
      }
    ]
  }
}
